# Keep the deployed azoth repository limited to litmus runtime artifacts and docs.

# Calibration, training, and analysis data. These are regenerated by collimator
# and are not needed by litmus at scan time.
*.npz
*.npy
*.pkl
*.pickle
*.parquet
*.feather
*.sqlite
*.sqlite3
*.db
*.log
cache/
logs/
runs/

# Generated diagnostics in machine-readable formats. Keep the markdown versions.
*.csv
global_policy_metrics.json
route_diagnostics.json
slice_metrics.json
score_table.json

# Training-only outputs.
benchmark.json
calibration_scores*.npz
cross_language_fixture.json
cv_predictions.npz
evaluation.json
extraction_fixture.json
shap_importance.json
threshold_scores.npz
threshold_tuning.json
model.pre-tail-contrast.txt

# Runtime files that are intentionally versioned.
!README.md
!MODELS.md
!TRAINING.md
!LICENSE
!config.json
!route_policies.json
!*.md
!general/
!filegroups/
!filetypes/
!general/model.txt
!general/feature_spec.json
!general/config.json
!general/README.md
!filegroups/*/
!filegroups/*/model.txt
!filegroups/*/feature_spec.json
!filegroups/*/README.md
!filetypes/*/
!filetypes/*/model.txt
!filetypes/*/feature_spec.json
!filetypes/*/README.md
